{
  "info": {
    "name": "FitLean API (MySQL)",
    "description": "Run the folders in order (1 Auth stores the tokens). Needs `npm run db:setup` and `npm start` in backend/ first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "memberToken",
      "value": ""
    },
    {
      "key": "member2Token",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "slotDate",
      "value": ""
    },
    {
      "key": "appointmentId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// slotDate = a Wednesday 1-2 weeks from today (trainers work Mon-Sat).",
          "if (!pm.collectionVariables.get('slotDate')) {",
          "  const d = new Date(); d.setDate(d.getDate() + 7);",
          "  while (d.getDay() !== 3) d.setDate(d.getDate() + 1);",
          "  const p = (n) => String(n).padStart(2, '0');",
          "  pm.collectionVariables.set('slotDate', d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()));",
          "}"
        ]
      }
    }
  ],
