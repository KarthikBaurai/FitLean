# Copy this file to .env and fill in your own values.
# .env is ignored by Git, so your password never reaches GitHub.

PORT=5000

# Your local MySQL server
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=fitlean

# Secret used to sign login tokens (JWT). Any long random string.
JWT_SECRET=change_me_to_a_long_random_string
